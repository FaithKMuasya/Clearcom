# Clearcom Next.js server environment — copy to .env and fill in values.
# Next.js loads .env automatically. These values are used only by the server action
# and must never be renamed with a NEXT_PUBLIC_ prefix.

# Outgoing SMTP — mail.clearcom.co.ke, port 465 (implicit TLS)
SMTP_HOST=mail.clearcom.co.ke
SMTP_PORT=465
SMTP_USER=info@clearcom.co.ke
SMTP_PASS=your-mailbox-password

# Where website inquiries and consultation requests are delivered
MAIL_TO=info@clearcom.co.ke
# Envelope sender — must be a mailbox on this SMTP server
MAIL_FROM=info@clearcom.co.ke

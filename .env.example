# Clearcom website environment config — copy to .env and fill in values.
# .env is gitignored; this template is safe to commit.

# API server port (Vite proxies /api here in dev; production serves dist + API on this port)
PORT=3001

# Outgoing SMTP — mail.clearcom.co.ke, port 465 (implicit TLS)
SMTP_HOST=mail.clearcom.co.ke
SMTP_PORT=465
SMTP_USER=info@clearcom.co.ke
SMTP_PASS=your-mailbox-password

# Where website inquiries are delivered
MAIL_TO=info@clearcom.co.ke
# Envelope sender — must be a mailbox on this SMTP server
MAIL_FROM=info@clearcom.co.ke
